{
    "title": "Algorithm Plugin Output Arguments",
    "description": "A schema for algorithm plugin output arguments",
    "type": "object",
    "required": [
        "results", 
        "probs_A",
        "probs_B", 
        "labels",
        "display_info",
        "matplotlib_image_path",
        "plotly_image_path",
        "html_carousel_path"
    ], 
    "minProperties": 1,
    "properties": {
        "results": {
            "description": "Algorithm Output",
            "type": "array",
            "minItems": 1,
            "items": {"type": "object"}
        },
        "probs_A": {
            "description": "predict_probabilities before",
            "type": "array",
            "minItems": 1,
            "items": {"type": "number"}
        },
        "probs_B": {
            "description": "predict_probabilities after",
            "type": "array",
            "minItems": 1,
            "items": {"type": "number"}
        },
        "labels": {
            "description": "labels",
            "type": "array",
            "minItems": 1,
            "items": {"type": "array"}
        },
        "display_info": {
            "description": "display information",
            "type": "array",
            "minItems": 1,
            "items": {"type": "object"}
        },
        "matplotlib_image_path": {
            "description": "matplotlib image",
            "type": "string"
        },
        "plotly_image_path": {
            "description": "plotly image",
            "type": "string"
        },
        "html_carousel_path": {
            "description": "html carousel of images",
            "type": "string"
        }
    }
}