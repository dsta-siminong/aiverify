{
    "title": "Algorithm Plugin Output Arguments",
    "description": "A schema for algorithm plugin output arguments",
    "type": "object",
    "required": ["results", "gradients", "first_drops", "augmentation_names"],
    "minProperties": 1,
    "properties": {
        "results": {
            "description": "Algorithm Output",
            "type": "array",
            "minItems": 1,
            "items": {"type": "object"}
        },
        "gradients": {
            "description": "List of gradients",
            "type": "array",
            "minItems": 1,
            "items": {"type": "number"}
        },
        "first_drops": {
            "description": "List of values of first drop in accuracy",
            "type": "array",
            "minItems": 1,
            "items": {"type": "number"}
        },
        "augmentation_names": {
            "description": "List of augmentations",
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
        }
    }
}